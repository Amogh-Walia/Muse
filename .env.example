# Copy to .env and adjust. Real environment variables override these.
# Relative paths are relative to the project folder.

# Your music folder (required). Muse catalogs it and organizes the files in it.
MUSE_LIBRARY=/path/to/your/music

# The SQLite catalog. Created, with a first scan, if it doesn't exist.
MUSE_DB=data/muse.db

# Undo journals, and the cache of cover images found or uploaded.
MUSE_JOURNAL_DIR=data/journal
MUSE_ART_CACHE=data/artwork-cache

# How long a change stays undoable, in days. After that its undo record expires, and the
# duplicates it moved to .muse-trash/ are deleted for good. 0 keeps everything.
MUSE_UNDO_DAYS=30

# Where the web app listens. Keep 127.0.0.1 unless it's behind authentication:
# the app can rename and retag your files.
MUSE_HOST=127.0.0.1
MUSE_PORT=8800

# Lookups (Scrape Details, artwork, lyrics) stop by themselves, keeping what they found, when no Muse page has
# been open for this many seconds. 0: let them run to the end regardless.
MUSE_STOP_UNWATCHED=120

# Optional: a URL or e-mail for the MusicBrainz User-Agent, as MusicBrainz asks.
MUSE_MB_CONTACT=

# Optional: Navidrome, for playback in the page and in Subsonic apps (documentation/navidrome-setup.md).
# Leave NAVIDROME_URL empty to go without: browser-friendly formats then play straight from disk.
NAVIDROME_URL=
NAVIDROME_USER=muse
NAVIDROME_PASSWORD=
# Address your browser uses for "Open in Navidrome" links, if not NAVIDROME_URL.
NAVIDROME_PUBLIC_URL=
# systemd user service Muse starts if Navidrome isn't answering (empty: don't try).
NAVIDROME_SERVICE=navidrome

# Optional: accent colours as #rrggbb, for light mode and (with _DARK) dark mode. Easiest to set from the
# Appearance menu in the app, which writes them here. Names: ACCENT, LINK, OK, WARN, DANGER.
# MUSE_COLOR_ACCENT=#b4532a
# MUSE_COLOR_ACCENT_DARK=#e08a5f
# MUSE_COLOR_LINK=#1f6f78
# MUSE_COLOR_LINK_DARK=#6ec3c9
